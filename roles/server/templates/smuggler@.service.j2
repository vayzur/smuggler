# {{ ansible_managed }}

[Unit]
Description=Smuggler {{ tun.name }} service
Documentation=https://github.com/vayzur
After=network.target nss-lookup.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

CPUAccounting=no
MemoryAccounting=no
IOAccounting=no
IPAccounting=no
TasksAccounting=no

CPUQuota=
MemoryMax=

OOMScoreAdjust=-1000
WatchdogSec=0

LimitRTPRIO=99
LimitRTTIME=infinity
LimitCPU=infinity
LimitFSIZE=infinity
LimitDATA=infinity
LimitSTACK=infinity
LimitCORE=infinity
LimitRSS=infinity
LimitNOFILE=infinity
LimitAS=infinity
LimitNPROC=infinity
LimitMEMLOCK=infinity
LimitLOCKS=infinity
LimitSIGPENDING=infinity
LimitMSGQUEUE=infinity

TimeoutStartSec=3s
TimeoutStopSec=3s
Restart=always
RestartSec=1s
{% if tun.engine == "slipstream" %}
ExecStart=/usr/local/bin/slipstream-server --dns-listen-host {{ tun.server.bind_addr | default(ansible_default_ipv4.address, true) }} --dns-listen-port {{ tun.server.bind_port | default(53, true) }} --target-address {{ tun.server.target_addr | default('127.0.0.1', true) }}:{{ tun.server.target_port | default(5201, true) }} --domain {{ tun.domain }} --cert {{ keys_path }}/{{ slipstream_pubkey }} --key {{ keys_path }}/{{ slipstream_privkey }} --max-connections {{ tun.server.max_connections | default(512, true) }} --idle-timeout-seconds {{ tun.server.idle_timeout_seconds | default(60, true) }} {{ tun.server.extra_cmdline | default('') }}
{% elif tun.engine == "dnstt" %}
ExecStart=/usr/local/bin/dnstt-server -udp {{ tun.server.bind_addr | default(ansible_default_ipv4.address, true) }}:{{ tun.server.bind_port | default(53, true) }} -mtu {{ tun.server.mtu | default(1232, true) }} -privkey-file {{ keys_path }}/{{ dnstt_privkey }} {{ tun.domain }} {{ tun.server.target_addr | default('127.0.0.1', true) }}:{{ tun.server.target_port | default('8000', true) }}
{% else %}
ExecStart=/usr/local/bin/vaydns-server -log-level {{ tun.server.log_level | default('warn', true) }} -idle-timeout {{ tun.server.idle_timeout | default('10s', true) }} -keepalive {{ tun.server.keepalive | default('2s', true) }} -clientid-size {{ tun.server.client_id_size | default(2, true) }} -record-type {{ tun.server.dns_record_type | default('txt', true) }} -mtu {{ tun.server.mtu | default(1232, true) }} -domain {{ tun.domain }} -privkey-file {{ keys_path }}/{{ vaydns_privkey }} -udp {{ tun.server.bind_addr | default(ansible_default_ipv4.address, true) }}:{{ tun.server.bind_port | default(53, true) }} -upstream {{ tun.server.target_addr | default('127.0.0.1', true) }}:{{ tun.server.target_port | default('2584', true) }}
{% endif %}

[Install]
WantedBy=multi-user.target
