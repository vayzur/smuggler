#!/bin/bash

TUNNEL="${1:?tunnel name required}"
PROXY="${2:?proxy required}"
URL="${3:?health check URL required}"
TIMEOUT="${4:?timeout required}"
LB="${5:-false}"

[[ "$LB" == "true" ]] && {
    LB_TABLE="smuggler_lb"
    LB_MAP="lb_backends"
    LB_MARK="${6:?lb mark required}"
    LB_IP="${7:?lb ip required}"
    LB_PORT="${8:?lb port required}"
    LB_BACKUP_IP="${9:?lb backup ip required}"
    LB_BACKUP_PORT="${10:?lb backup port required}"
}

set_backend() {
    local ip=$1 port=$2
    nft delete element ip "$LB_TABLE" "$LB_MAP" { "$LB_MARK" } 2>/dev/null || true
    nft add element ip "$LB_TABLE" "$LB_MAP" { "$LB_MARK" : "$ip" . "$port" } 2>/dev/null || true
}

if curl -x "$PROXY" --max-time "$TIMEOUT" -so /dev/null "$URL"; then
    [[ "$LB" == "true" ]] && set_backend "$LB_IP" "$LB_PORT"
else
    [[ "$LB" == "true" ]] && set_backend "$LB_BACKUP_IP" "$LB_BACKUP_PORT"
    systemctl restart "smuggler@${TUNNEL}.service"
    exit 1
fi
