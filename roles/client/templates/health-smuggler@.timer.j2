# {{ ansible_managed }}

[Unit]
Description=Run Health Check for Smuggler Instance {{ tun.name }} every {{ tun.client.health_check.interval | default('3s') }}

[Timer]
OnUnitActiveSec={{ tun.client.health_check.interval | default('3s') }}
AccuracySec=50ms
Unit=health-smuggler@{{ tun.name }}.service

[Install]
WantedBy=timers.target
