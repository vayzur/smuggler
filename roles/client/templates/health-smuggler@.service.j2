# {{ ansible_managed }}

[Unit]
Description=Smuggler Health Check Service for Instance {{ tun.name }}
Documentation=https://github.com/vayzur
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=oneshot
ExecStart=/opt/health-smuggler.sh {{ tun.name }} {{ tun.client.health_check.proxy_type }}://{{ tun.client.health_check.proxy_addr }}:{{ tun.client.health_check.proxy_port }} {{ tun.client.health_check.test_url | default('http://www.google.com/gen_204') }} {{ tun.client.health_check.timeout | default(3) }} {{ tun.client.lb.enabled | default(false) | lower }} {{ tun_idx }} {{ tun.client.bind_addr if tun.client.bind_addr != '0.0.0.0' else '127.0.0.1' }} {{ tun.client.bind_port }} {{ tun.client.lb.backup_addr if tun.client.lb.backup_addr != '0.0.0.0' else '127.0.0.1' }} {{ tun.client.lb.backup_port }}
