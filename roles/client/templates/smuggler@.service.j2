# {{ ansible_managed }}

[Unit]
Description=Smuggler {{ tun.name }} service
Documentation=https://github.com/vayzur
After=network.target nss-lookup.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple

CPUAccounting=no
MemoryAccounting=no
IOAccounting=no
IPAccounting=no
TasksAccounting=no

CPUQuota=
MemoryMax=

OOMScoreAdjust=-1000
WatchdogSec=0

LimitRTPRIO=99
LimitRTTIME=infinity
LimitCPU=infinity
LimitFSIZE=infinity
LimitDATA=infinity
LimitSTACK=infinity
LimitCORE=infinity
LimitRSS=infinity
LimitNOFILE=infinity
LimitAS=infinity
LimitNPROC=infinity
LimitMEMLOCK=infinity
LimitLOCKS=infinity
LimitSIGPENDING=infinity
LimitMSGQUEUE=infinity

TimeoutStartSec=3s
TimeoutStopSec=3s
Restart=always
RestartSec=1s
{% set dns_resolver = tun.client.dns_resolver | default('8.8.8.8:53', true) %}
{% if tun.engine == "slipstream" %}
ExecStart=/usr/local/bin/slipstream-client --tcp-listen-host {{ tun.client.bind_addr | default('0.0.0.0', true) }} --tcp-listen-port {{ tun.client.bind_port | default(5201, true) }} {{ (dns_resolver is iterable and dns_resolver is not string) | ternary(dns_resolver | map('regex_replace','^(.*)$','--resolver \\1') | join(' '), '--resolver ' ~ dns_resolver) }} --domain {{ tun.domain }} --keep-alive-interval {{ tun.client.keep_alive_interval | default(200, true) }} {{ tun.client.extra_cmdline | default('') }}
{% elif tun.engine == "dnstt" %}
ExecStart=/usr/local/bin/dnstt-client -{{ tun.client.dns_protocol | default('udp', true) }} {{ dns_resolver }} -pubkey-file {{ keys_path }}/{{ dnstt_pubkey }} {{ tun.domain }} {{ tun.client.bind_addr | default('0.0.0.0', true) }}:{{ tun.client.bind_port | default(7000, true) }}
{% else %}
ExecStart=/usr/local/bin/vaydns-client -log-level {{ tun.client.log_level | default('warn', true) }} -udp-timeout {{ tun.client.udp_timeout | default('200ms', true) }} -idle-timeout {{ tun.client.idle_timeout | default('10s', true) }} -keepalive {{ tun.client.keepalive | default('2s', true) }} -open-stream-timeout {{ tun.client.open_stream_timeout | default('10s', true) }} -reconnect-max {{ tun.client.reconnect_max | default('30s', true) }} -reconnect-min {{ tun.client.reconnect_min | default('1s', true) }} -session-check-interval {{ tun.client.session_check_interval | default('500ms', true) }} -udp-workers {{ tun.client.udp_workers | default(100, true) }} -rps {{ tun.client.rps | default(0, true) }} -max-streams {{ tun.client.max_streams | default(0, true) }} -max-qname-len {{ tun.client.max_qname_len | default(0, true) }} -max-num-labels {{ tun.client.max_num_labels | default(2, true) }} -domain {{ tun.domain }} -pubkey-file {{ keys_path }}/{{ vaydns_pubkey }} -listen {{ tun.client.bind_addr | default('0.0.0.0', true) }}:{{ tun.client.bind_port | default(2584, true) }} -{{ tun.client.dns_protocol | default('udp', true) }} {{ dns_resolver }}{% if tun.client.udp_accept_errors | default(false, true) %} -udp-accept-errors{% endif %}{% if tun.client.udp_shared_socket | default(false, true) %} -udp-shared-socket{% endif %}
{% endif %}

[Install]
WantedBy=multi-user.target
