#!/usr/sbin/nft -f
# vim: set tabstop=4 shiftwidth=4 expandtab:

table ip smuggler_lb {
{% if lb.enabled | default(false) %}
    set lb_ports {
        type inet_service
        flags interval
        auto-merge
        elements = { {{ lb.ports | join(', ') }} }
    }

    map lb_backends {
        typeof meta mark : ip daddr . tcp dport
        flags dynamic
        elements = { {% for tun in smuggler_tunnels %}{% if tun.client.lb.enabled | default(false) %}{{ loop.index0 }} : {{ tun.client.bind_addr if tun.client.bind_addr != '0.0.0.0' else '127.0.0.1' }} . {{ tun.client.bind_port }}{% if not loop.last %},{% endif %}{% endif %}{% endfor %} }
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

{% if lb.type == 'hash' %}
        tcp dport @lb_ports meta mark set jhash ip saddr . tcp sport mod {{ smuggler_tunnels_length }} dnat to meta mark map @lb_backends
{% elif lb.type == 'random' %}
        tcp dport @lb_ports meta mark set numgen random mod {{ smuggler_tunnels_length }} dnat to meta mark map @lb_backends
{% else %}
        tcp dport @lb_ports meta mark set numgen inc mod {{ smuggler_tunnels_length }} dnat to meta mark map @lb_backends
{% endif %}

    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname != "lo" iifname "lo" snat to {{ ansible_default_ipv4.address }}
    }
{% endif %}

{% if dns_lb.enabled | default(false) %}
    map resolvers {
        typeof meta mark : ip daddr . udp dport
        flags dynamic
        elements = { {% for resolver in dns_lb.resolvers %}{{ loop.index0 }} : {{ resolver }} . 53{{ ', ' if not loop.last }}{%- endfor %} }
    }

    chain output {
        type nat hook output priority -100; policy accept;
{% if dns_lb.type == 'hash' %}
        udp dport 53 meta mark set jhash ip saddr . udp sport mod {{ dns_dns_.resolvers | list | length }} dnat to meta mark map @resolvers
{% elif dns_lb.type == 'random' %}
        udp dport 53 meta mark set numgen random mod {{ dns_lb.resolvers | dns_list | length }} dnat to meta mark map @resolvers
{% else %}
        udp dport 53 meta mark set numgen inc mod {{ dns_lb.resolvers | list | length }} dnat to meta mark map @resolvers
{% endif %}

    }
{% endif %}

}
